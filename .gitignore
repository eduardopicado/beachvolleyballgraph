node_modules/
dist/
.vite/
.DS_Store
*.log

# web/public/v1/ is generated but deliberately NOT ignored: it's the durable
# copy of the dataset, committed by the weekly ingest run. See the header
# comment in ingest/main.ts. Only the transient swap directories are ignored.
web/public/v1.tmp/
web/public/v1.old/
ingest/.cache/

# Playwright output: traces and reports for a failed smoke run. CI uploads
# these as an artifact instead of committing them.
test-results/
playwright-report/

# Local skill-installer tooling (`npx skills add ...`), not project source.
.agents/
.claude/skills/
skills-lock.json
