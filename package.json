{
  "name": "beachvolleyballgraph",
  "version": "1.0.0",
  "private": true,
  "license": "UNLICENSED",
  "type": "module",
  "description": "Partnership graph of FIVB international beach volleyball players, by country and gender.",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "ingest": "tsx ingest/main.ts",
    "dev": "vite",
    "build": "tsc --noEmit && vite build && tsx ingest/prerender.ts",
    "prerender": "tsx ingest/prerender.ts",
    "preview": "vite preview",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . && stylelint \"web/src/**/*.css\""
  },
  "dependencies": {
    "d3-force": "^3.0.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@playwright/test": "1.62.1",
    "@types/d3-force": "^3.0.10",
    "@types/node": "^22.10.2",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "@vitest/coverage-v8": "^2.1.9",
    "eslint": "^9.39.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.5.3",
    "globals": "^17.9.0",
    "stylelint": "^17.14.1",
    "stylelint-config-recommended": "^18.0.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.66.0",
    "vite": "^6.0.7",
    "vitest": "^2.1.8"
  }
}
