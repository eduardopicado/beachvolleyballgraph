{
  "name": "beachvolleyballgraph",
  "version": "1.0.0",
  "private": true,
  "license": "UNLICENSED",
  "type": "module",
  "description": "Partnership graph of FIVB international beach volleyball players, by country and gender.",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "ingest": "tsx ingest/main.ts",
    "dev": "vite",
    "build": "tsc --noEmit && vite build && tsx ingest/photos.ts && tsx ingest/prerender.ts",
    "prerender": "tsx ingest/prerender.ts",
    "preview": "vite preview",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . && stylelint \"web/src/**/*.css\""
  },
  "dependencies": {
    "country-flag-emoji-polyfill": "^0.1.10",
    "d3-force": "^3.0.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "1.64.1",
    "@types/d3-force": "^3.0.10",
    "@types/node": "^24.19.2",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^6.1.2",
    "@vitest/coverage-v8": "^5.0.1",
    "eslint": "^10.13.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.3",
    "globals": "^17.9.0",
    "jsdom": "^29.1.1",
    "stylelint": "^17.14.1",
    "stylelint-config-recommended": "^18.0.0",
    "tsx": "^4.19.2",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.66.0",
    "vite": "^8.3.4",
    "vitest": "^5.0.1"
  }
}
